{
  "openapi": "3.1.0",
  "info": {
    "title": "SEDRA scoped integration API",
    "version": "0.13.0",
    "description": "Loopback prototype. See docs/INTEGRATIONS.md for cursor, authorization and evidence contracts."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "paths": {
    "/api/v1/alerts": {
      "get": {
        "summary": "alerts:read /alerts",
        "x-required-scope": "alerts:read",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Older alert sequence cursor"
          }
        ]
      }
    },
    "/api/v1/alerts/action": {
      "post": {
        "summary": "alerts:write /alerts/action",
        "x-required-scope": "alerts:write",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewAction"
              }
            }
          }
        }
      }
    },
    "/api/v1/cases": {
      "get": {
        "summary": "cases:read /cases",
        "x-required-scope": "cases:read",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        }
      }
    },
    "/api/v1/cases/changes": {
      "get": {
        "summary": "cases:read /cases/changes",
        "x-required-scope": "cases:read",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Last processed cursor; first call 0"
          },
          {
            "name": "generation",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Required with nonzero cursor; reset on generation conflict"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Page size 1\u2013100; default 100"
          }
        ]
      }
    },
    "/api/v1/cases/action": {
      "post": {
        "summary": "cases:write /cases/action",
        "x-required-scope": "cases:write",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewAction"
              }
            }
          }
        }
      }
    },
    "/api/v1/ueba": {
      "get": {
        "summary": "ueba:read /ueba",
        "x-required-scope": "ueba:read",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "parameters": [
          {
            "name": "subject",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Known realm actor; default lab-001"
          }
        ]
      }
    },
    "/api/v1/telemetry": {
      "post": {
        "summary": "telemetry:write /telemetry",
        "x-required-scope": "telemetry:write",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Telemetry"
              }
            }
          }
        }
      }
    },
    "/api/v1/browser/inspect": {
      "post": {
        "summary": "Inspect a guarded browser action; never forwards to an AI provider",
        "x-required-scope": "browser:inspect",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "description": "Key must bind exactly one lab subject. Identity, UEBA score and destination policy are server-computed. ALLOW release is one-use and delivery-unknown. Preview ALLOW does not reserve exposure. See docs/BROWSER_GUARD.md.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrowserInspection"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ALLOW or BLOCK policy verdict; response includes alert IDs, masked finding types and delivery_confirmed=false"
          },
          "400": {
            "description": "Invalid schema or changed request binding"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subject or Origin denied"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "summary": "Analyst session audit metadata; not bearer-key accessible",
        "parameters": [
          {
            "in": "query",
            "name": "source",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "API",
                "HTTP",
                "UI",
                "APPLICATION"
              ]
            }
          },
          {
            "in": "query",
            "name": "before",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded persistent metadata page; scope and write-failure count included"
          },
          "403": {
            "description": "Analyst session required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "SEDRA scoped API key"
      }
    },
    "schemas": {
      "Telemetry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "subject_id",
                "occurred_at",
                "kind",
                "doc_id"
              ],
              "properties": {
                "event_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "subject_id": {
                  "type": "string"
                },
                "occurred_at": {
                  "type": "number",
                  "description": "UTC epoch seconds, preceding 30 minutes"
                },
                "kind": {
                  "const": "protected_document_access"
                },
                "doc_id": {
                  "type": "string",
                  "enum": [
                    "araz-plan",
                    "isiq-research",
                    "restricted-runbook",
                    "public-note"
                  ]
                }
              }
            }
          }
        }
      },
      "ReviewAction": {
        "type": "object",
        "description": "Closed server schema; use case_id for cases, alert_id for alerts. Resolution disposition is mandatory only for RESOLVE.",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "alert_id": {
            "type": "string"
          },
          "action_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "READ",
              "ACKNOWLEDGE",
              "RESOLVE",
              "REOPEN"
            ]
          },
          "disposition": {
            "type": "string"
          }
        },
        "required": [
          "action_id",
          "expected_revision",
          "action"
        ]
      },
      "BrowserInspection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "host",
          "operation",
          "mode",
          "text",
          "files"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^br-[A-Za-z0-9_-]{8,96}$"
          },
          "host": {
            "type": "string",
            "enum": [
              "gemini.google.com",
              "chatgpt.com",
              "chat.openai.com",
              "claude.ai",
              "sedra-browser-lab"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "paste",
              "draft",
              "send",
              "file",
              "drop",
              "offline"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "preview",
              "release"
            ]
          },
          "text": {
            "type": "string",
            "description": "Combined extracted UTF-8 bound is 64 KiB"
          },
          "files": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "data"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "data": {
                  "type": "string",
                  "format": "byte",
                  "description": "Strict Base64, at most 512 KiB decoded per file"
                }
              }
            }
          },
          "failure": {
            "type": "string",
            "enum": [
              "FILE_TOO_LARGE",
              "UNSUPPORTED_FILE",
              "LOCAL_INSPECTION_FAILED",
              "BACKEND_UNAVAILABLE",
              "UNSUPPORTED_COMPOSER"
            ]
          }
        }
      }
    }
  }
}
