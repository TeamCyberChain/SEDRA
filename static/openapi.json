{
  "openapi": "3.1.0",
  "info": {
    "title": "SEDRA scoped integration API",
    "version": "0.20.0",
    "description": "Loopback prototype. See docs/INTEGRATIONS.md for cursor, authorization and evidence contracts."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "paths": {
    "/api/v1/alerts": {
      "get": {
        "summary": "alerts:read /alerts",
        "x-required-scope": "alerts:read",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Older alert sequence cursor"
          }
        ]
      }
    },
    "/api/v1/alerts/action": {
      "post": {
        "summary": "alerts:write /alerts/action",
        "x-required-scope": "alerts:write",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewAction"
              }
            }
          }
        }
      }
    },
    "/api/v1/cases": {
      "get": {
        "summary": "cases:read /cases",
        "x-required-scope": "cases:read",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        }
      }
    },
    "/api/v1/cases/changes": {
      "get": {
        "summary": "cases:read /cases/changes",
        "x-required-scope": "cases:read",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Last processed cursor; first call 0"
          },
          {
            "name": "generation",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Required with nonzero cursor; reset on generation conflict"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Page size 1\u2013100; default 100"
          }
        ]
      }
    },
    "/api/v1/cases/action": {
      "post": {
        "summary": "cases:write /cases/action",
        "x-required-scope": "cases:write",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewAction"
              }
            }
          }
        }
      }
    },
    "/api/v1/ueba": {
      "get": {
        "summary": "ueba:read /ueba",
        "x-required-scope": "ueba:read",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "parameters": [
          {
            "name": "subject",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Known realm actor; default lab-001"
          }
        ]
      }
    },
    "/api/v1/telemetry": {
      "post": {
        "summary": "telemetry:write /telemetry",
        "x-required-scope": "telemetry:write",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Scope or subject denied"
          },
          "409": {
            "description": "Revision, source-fact or generation conflict"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Telemetry"
              }
            }
          }
        }
      }
    },
    "/api/v1/browser/inspect": {
      "post": {
        "summary": "Inspect a guarded browser action; never forwards to an AI provider",
        "x-required-scope": "browser:inspect",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "description": "Key must bind exactly one lab subject. Identity, UEBA score and destination policy are server-computed. ALLOW release is one-use and delivery-unknown. Preview ALLOW does not reserve exposure. See docs/BROWSER_GUARD.md.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrowserInspection"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ALLOW or BLOCK policy verdict; response includes alert IDs, masked finding types and delivery_confirmed=false"
          },
          "400": {
            "description": "Invalid schema or changed request binding"
          },
          "401": {
            "description": "Invalid, expired or revoked key"
          },
          "403": {
            "description": "Scope, subject or Origin denied"
          },
          "429": {
            "description": "Per-key quota exceeded"
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "summary": "Analyst session audit metadata; not bearer-key accessible",
        "parameters": [
          {
            "in": "query",
            "name": "source",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "API",
                "HTTP",
                "UI",
                "APPLICATION"
              ]
            }
          },
          {
            "in": "query",
            "name": "before",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded persistent metadata page; scope and write-failure count included"
          },
          "403": {
            "description": "Analyst session required"
          }
        }
      }
    },
    "/api/dashboards": {
      "get": {
        "summary": "Analyst observed aggregates, own saved dashboards and widget/metric catalogs; days 1|7|30",
        "description": "Cookie session authentication; POST requires X-CSRF-Token. These UI endpoints do not accept scoped machine keys. See docs/WORKSPACE_MFA_REPORTS.md.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid bounded schema"
          },
          "401": {
            "description": "Password and MFA sign-in required"
          },
          "403": {
            "description": "CSRF, role or subject denied"
          }
        }
      }
    },
    "/api/reports": {
      "get": {
        "summary": "List authorized saved snapshots; id and format=json|csv|pdf retrieve one",
        "description": "Cookie session authentication; POST requires X-CSRF-Token. These UI endpoints do not accept scoped machine keys. See docs/WORKSPACE_MFA_REPORTS.md.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid bounded schema"
          },
          "401": {
            "description": "Password and MFA sign-in required"
          },
          "403": {
            "description": "CSRF, role or subject denied"
          }
        }
      },
      "post": {
        "summary": "Save snapshot: template executive|security|activity, integer days 1|7|30, subject_id string; User activity/own subject only",
        "description": "Cookie session authentication; POST requires X-CSRF-Token. These UI endpoints do not accept scoped machine keys. See docs/WORKSPACE_MFA_REPORTS.md.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid bounded schema"
          },
          "401": {
            "description": "Password and MFA sign-in required"
          },
          "403": {
            "description": "CSRF, role or subject denied"
          }
        }
      }
    },
    "/api/account/mfa/enroll": {
      "post": {
        "summary": "Pending password-verified session only; empty object; local setup QR and key",
        "description": "Cookie session authentication; POST requires X-CSRF-Token. These UI endpoints do not accept scoped machine keys. See docs/WORKSPACE_MFA_REPORTS.md.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid bounded schema"
          },
          "401": {
            "description": "Password and MFA sign-in required"
          },
          "403": {
            "description": "CSRF, role or subject denied"
          }
        }
      }
    },
    "/api/account/mfa/verify": {
      "post": {
        "summary": "Pending challenge only; object code authenticator or one-use recovery; rotate to full session",
        "description": "Cookie session authentication; POST requires X-CSRF-Token. These UI endpoints do not accept scoped machine keys. See docs/WORKSPACE_MFA_REPORTS.md.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid bounded schema"
          },
          "401": {
            "description": "Password and MFA sign-in required"
          },
          "403": {
            "description": "CSRF, role or subject denied"
          }
        }
      }
    },
    "/api/accounts/mfa": {
      "post": {
        "summary": "Reauthenticated MFA operator action: id, expected_version, action=enroll|replace|remove, reason, password, code",
        "description": "Local account cookie and X-CSRF-Token required. No registered seed is returned. See docs/MFA_MANAGEMENT.md.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid schema or stale target version"
          },
          "401": {
            "description": "Sign-in required"
          },
          "403": {
            "description": "Permission, factor, CSRF or challenge denied"
          }
        }
      }
    },
    "/api/account/mfa/replace/start": {
      "post": {
        "summary": "Owner replacement setup after current password and fresh MFA code",
        "description": "Local account cookie and X-CSRF-Token required. No registered seed is returned. See docs/MFA_MANAGEMENT.md.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid schema or stale target version"
          },
          "401": {
            "description": "Sign-in required"
          },
          "403": {
            "description": "Permission, factor, CSRF or challenge denied"
          }
        }
      }
    },
    "/api/account/mfa/replace/confirm": {
      "post": {
        "summary": "Atomically confirm a pending owner replacement using the new authenticator code",
        "description": "Local account cookie and X-CSRF-Token required. No registered seed is returned. See docs/MFA_MANAGEMENT.md.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid schema or stale target version"
          },
          "401": {
            "description": "Sign-in required"
          },
          "403": {
            "description": "Permission, factor, CSRF or challenge denied"
          }
        }
      }
    },
    "/api/dashboards/saved": {
      "get": {
        "summary": "List own active dashboards; archived=1 lists own archived layouts",
        "description": "MFA-verified Analyst cookie session. Owner-scoped configuration only; no API key authentication. POST requires X-CSRF-Token. See docs/DASHBOARD_BUILDER.md for exact closed schemas and widget fields.",
        "responses": {
          "200": {
            "description": "Owner-scoped result"
          },
          "400": {
            "description": "Invalid bounded schema or unavailable owner resource"
          },
          "401": {
            "description": "Password and MFA required"
          },
          "403": {
            "description": "Analyst role or CSRF denied"
          },
          "409": {
            "description": "Stale revision or status conflict"
          }
        }
      },
      "post": {
        "summary": "Create, update, archive or restore an owner-scoped layout; writes use expected_revision",
        "description": "MFA-verified Analyst cookie session. Owner-scoped configuration only; no API key authentication. POST requires X-CSRF-Token. See docs/DASHBOARD_BUILDER.md for exact closed schemas and widget fields.",
        "responses": {
          "200": {
            "description": "Owner-scoped result"
          },
          "400": {
            "description": "Invalid bounded schema or unavailable owner resource"
          },
          "401": {
            "description": "Password and MFA required"
          },
          "403": {
            "description": "Analyst role or CSRF denied"
          },
          "409": {
            "description": "Stale revision or status conflict"
          }
        }
      }
    },
    "/api/v1/endpoint/events": {
      "post": {
        "summary": "Ingest device-bound endpoint metadata; endpoint:write only",
        "description": "Exact enrolled device_id, bound subject_id, events (0\u201350), four-channel coverage and cumulative dropped count. Event IDs deduplicate atomically; changed facts return 409. Nonfuture events no older than seven days. See docs/WINDOWS_AGENT.md for closed fingerprint schemas.",
        "security": [
          {
            "bearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Bound acknowledgment; accepted/duplicates and exact acked_event_ids"
          },
          "400": {
            "description": "Invalid metadata or time"
          },
          "401": {
            "description": "Invalid/expired/revoked key"
          },
          "403": {
            "description": "Wrong device, subject or scope"
          },
          "409": {
            "description": "Changed event facts"
          },
          "429": {
            "description": "Rate/retention capacity"
          }
        }
      }
    },
    "/api/agents": {
      "get": {
        "summary": "Analyst-only enrolled device directory, reported coverage/freshness",
        "responses": {
          "200": {
            "description": "No secrets; device/key metadata"
          },
          "403": {
            "description": "Analyst required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "SEDRA scoped API key"
      }
    },
    "schemas": {
      "Telemetry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "subject_id",
                "occurred_at",
                "kind",
                "doc_id"
              ],
              "properties": {
                "event_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "subject_id": {
                  "type": "string"
                },
                "occurred_at": {
                  "type": "number",
                  "description": "UTC epoch seconds, preceding 30 minutes"
                },
                "kind": {
                  "const": "protected_document_access"
                },
                "doc_id": {
                  "type": "string",
                  "enum": [
                    "araz-plan",
                    "isiq-research",
                    "restricted-runbook",
                    "public-note"
                  ]
                }
              }
            }
          }
        }
      },
      "ReviewAction": {
        "type": "object",
        "description": "Closed server schema; use case_id for cases, alert_id for alerts. Resolution disposition is mandatory only for RESOLVE.",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "alert_id": {
            "type": "string"
          },
          "action_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "READ",
              "ACKNOWLEDGE",
              "RESOLVE",
              "REOPEN"
            ]
          },
          "disposition": {
            "type": "string"
          }
        },
        "required": [
          "action_id",
          "expected_revision",
          "action"
        ]
      },
      "BrowserInspection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "host",
          "operation",
          "mode",
          "text",
          "files"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^br-[A-Za-z0-9_-]{8,96}$"
          },
          "host": {
            "type": "string",
            "enum": [
              "gemini.google.com",
              "chatgpt.com",
              "chat.openai.com",
              "claude.ai",
              "sedra-browser-lab"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "paste",
              "draft",
              "send",
              "file",
              "drop",
              "offline"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "preview",
              "release"
            ]
          },
          "text": {
            "type": "string",
            "description": "Combined extracted UTF-8 bound is 64 KiB"
          },
          "files": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "data"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "data": {
                  "type": "string",
                  "format": "byte",
                  "description": "Strict Base64, at most 512 KiB decoded per file"
                }
              }
            }
          },
          "failure": {
            "type": "string",
            "enum": [
              "FILE_TOO_LARGE",
              "UNSUPPORTED_FILE",
              "LOCAL_INSPECTION_FAILED",
              "BACKEND_UNAVAILABLE",
              "UNSUPPORTED_COMPOSER"
            ]
          }
        }
      }
    }
  }
}
