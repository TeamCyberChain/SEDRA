{
  "manifest_version": 3,
  "name": "SEDRA Browser Guard",
  "version": "0.11.1",
  "description": "Local policy checks for AI composers and bounded text/Office attachments. Scoped pilot, not endpoint-wide DLP.",
  "key": "",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "options.html",
    "default_title": "SEDRA Browser Guard"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "http://127.0.0.1:8765/browser-lab*"
      ],
      "js": [
        "core.js",
        "guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "update_url": "http://127.0.0.1:8765/browser-deployment/updates.xml"
}
